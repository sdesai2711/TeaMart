<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="TeaMart.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TeaMart - Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --nav-bg: #2B3539;
            --footer-bg: #1B232E;
            --accent-yellow: #F5B01E;
            --text-gray: #8F9CA7;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #FFFFFF;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: var(--nav-bg);
            padding: 10px 0;
        }

        .navbar-brand-logo {
            height: 58px;
            width: auto;
            object-fit: contain;
            transition: transform 0.2s ease;
        }

            .navbar-brand-logo:hover {
                transform: scale(1.04);
            }

        .nav-link {
            color: #C8D1D5 !important;
            font-size: 14px;
            font-weight: 500;
            margin: 0 10px;
            transition: color 0.2s ease;
        }

            .nav-link.active,
            .nav-link:hover,
            .dropdown-item.active {
                color: var(--accent-yellow) !important;
                font-weight: 600;
            }

        .search-box input {
            font-size: 13px;
            border-radius: 4px 0 0 4px;
            border: none;
            padding: 7px 14px;
            outline: none;
            width: 180px;
        }

        .search-box button {
            background-color: var(--accent-yellow);
            color: #222;
            font-weight: 600;
            font-size: 13px;
            border: none;
            border-radius: 0 4px 4px 0;
            padding: 7px 16px;
        }

        .nav-action-icon {
            color: #C8D1D5;
            font-size: 17px;
            text-decoration: none;
            margin-left: 18px;
            position: relative;
            display: flex;
            align-items: center;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
        }

            .nav-action-icon:hover,
            .nav-action-icon:focus {
                color: #FFFFFF;
            }

        /* પ્રોફાઇલ ડ્રોપડાઉન સ્ટાઇલ */
        .profile-dropdown-menu {
            min-width: 140px;
            padding: 8px 0;
            border-radius: 8px;
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 4px 14px rgba(0,0,0,0.12);
            margin-top: 10px !important;
        }

            .profile-dropdown-menu .dropdown-item {
                font-size: 14px;
                padding: 8px 18px;
                color: #2b3539;
                font-weight: 500;
                transition: background-color 0.15s ease;
            }

            .profile-dropdown-menu .dropdown-item:hover {
                background-color: #f8f9fa;
                color: #0d6efd !important;
            }

        .cart-badge {
            position: absolute;
            top: -7px;
            right: -10px;
            background-color: #E74C3C;
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 50px;
        }

        .footer-custom {
            background-color: var(--footer-bg);
            color: var(--text-gray);
            padding-top: 55px;
            margin-top: auto;
            font-size: 12.5px;
        }

        .footer-logo {
            height: 60px;
            width: auto;
            object-fit: contain;
            display: block;
            margin-bottom: 16px;
        }

        .footer-brand-text {
            color: #7A8995;
            font-size: 11.5px;
            line-height: 1.5;
            margin-bottom: 0;
        }

        .footer-title {
            color: var(--accent-yellow);
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 18px;
            letter-spacing: 0.3px;
        }

        .footer-info-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #D0D7DE;
            margin-bottom: 10px;
            font-size: 12px;
        }

            .footer-info-item i {
                color: var(--accent-yellow);
                font-size: 13px;
                width: 14px;
            }

        .social-icons a {
            color: #CED4DA;
            font-size: 15px;
            margin-right: 14px;
            text-decoration: none;
        }

            .social-icons a:hover {
                color: var(--accent-yellow);
            }

        .newsletter-label {
            font-size: 11px;
            color: #7A8995;
            margin-bottom: 8px;
        }

        .newsletter-input {
            background-color: #FFFFFF;
            border: none;
            border-radius: 4px;
            height: 34px;
            font-size: 12px;
            padding: 0 12px;
            color: #333;
            width: 100%;
        }

            .newsletter-input:focus {
                outline: none;
            }

        .btn-subscribe-custom {
            background-color: var(--accent-yellow);
            color: #1A202C;
            font-weight: 700;
            font-size: 12px;
            border: none;
            border-radius: 4px;
            height: 34px;
            width: 100%;
            margin-top: 8px;
        }

        .footer-cat-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-cat-list li {
                margin-bottom: 10px;
            }

            .footer-cat-list a {
                color: #CBD5E1;
                text-decoration: none;
                font-size: 12.5px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .footer-cat-list a:hover {
                    color: var(--accent-yellow);
                }

        .footer-bottom-bar {
            border-top: 1px solid #252F3C;
            padding: 18px 0;
            margin-top: 40px;
            font-size: 11px;
            color: #6C7A87;
        }

        .footer-bottom-links a {
            color: #6C7A87;
            text-decoration: none;
            margin-left: 20px;
            font-size: 11px;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand text-white fw-bold d-flex align-items-center" href='<%= ResolveUrl("~/User/Home.aspx") %>'>
                    <img src='<%= ResolveUrl("~/Images/TeaMart.png") %>' alt="TeaMart" class="navbar-brand-logo" />
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav mx-auto align-items-center" id="userNavBar">
                        <li class="nav-item"><a class="nav-link" href='<%= ResolveUrl("~/User/Home.aspx") %>'>Home</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Categories</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href='<%= ResolveUrl("~/User/Tea.aspx") %>'>Tea</a></li>
                                <li><a class="dropdown-item" href='<%= ResolveUrl("~/User/Coffee.aspx") %>'>Coffee</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href='<%= ResolveUrl("~/User/Offer.aspx") %>'>Offers</a></li>
                        <li class="nav-item"><a class="nav-link" href='<%= ResolveUrl("~/User/About.aspx") %>'>About Us</a></li>
                        <li class="nav-item"><a class="nav-link" href='<%= ResolveUrl("~/User/Contact.aspx") %>'>Contact</a></li>
                    </ul>

                    <div class="d-flex align-items-center">
                        <div class="d-flex search-box me-2">
                            <input type="text" placeholder="Search for Products..." />
                            <button type="button">Search</button>
                        </div>

                        <!-- Profile Dropdown -->
                        <div class="dropdown">
                            <a href="#" class="nav-action-icon" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
                                <i class="fa-solid fa-user"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu" aria-labelledby="profileDropdown">
                                <li>
                                    <a class="dropdown-item" href='<%= ResolveUrl("~/User/Profile.aspx") %>'>Profile</a>
                                </li>
                                <li>
                                    <!-- User ફોલ્ડરની બહાર મેઇન Home.aspx માટે -->
                                    <a class="dropdown-item" href='<%= ResolveUrl("~/Home.aspx") %>'>Logout</a>
                                </li>
                            </ul>
                        </div>

                        <!-- Shopping Cart -->
                        <a href='<%= ResolveUrl("~/User/Cart.aspx") %>' class="nav-action-icon" title="Shopping Cart">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span class="cart-badge">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="footer-custom">
            <div class="container">
                <div class="row g-4 justify-content-between">
                    <div class="col-lg-3 col-md-4">
                        <img src='<%= ResolveUrl("~/Images/TeaMart.png") %>' alt="TeaMart Logo" class="footer-logo" />
                        <p class="footer-brand-text">
                            TeaMart - Your Premium<br />
                            Organic Tea &amp; Coffee Shop.
                        </p>
                    </div>

                    <div class="col-lg-2 col-md-3">
                        <div class="footer-title">Contact Us</div>
                        <div class="footer-info-item">
                            <i class="fa-solid fa-phone"></i>
                            <span>+91 6353060649</span>
                        </div>
                        <div class="footer-info-item">
                            <i class="fa-solid fa-envelope"></i>
                            <span>Teamart@gmail.com</span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-4">
                        <div class="footer-title">Follow Us</div>
                        <div class="social-icons mb-3">
                            <a href="#"><i class="fa-brands fa-twitter"></i></a>
                            <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        </div>
                        <div class="footer-title mb-1">Newsletter</div>
                        <div class="newsletter-label">Sign up to receive the latest updates and offers.</div>
                        <input type="email" class="newsletter-input" placeholder="Enter your email" />
                        <button type="button" class="btn-subscribe-custom">Subscribe</button>
                    </div>

                    <div class="col-lg-2 col-md-3">
                        <div class="footer-title">Our Categories</div>
                        <ul class="footer-cat-list">
                            <li><a href='<%= ResolveUrl("~/User/Tea.aspx") %>'><i class="fa-solid fa-leaf text-success" style="font-size: 11px;"></i>Organic Teas</a></li>
                            <li><a href='<%= ResolveUrl("~/User/Coffee.aspx") %>'><i class="fa-solid fa-mug-hot" style="color: #D97706; font-size: 11px;"></i>Premium Coffee</a></li>
                            <li><a href="#"><i class="fa-solid fa-blender" style="color: #94A3B8; font-size: 11px;"></i>Accessories</a></li>
                            <li><a href='<%= ResolveUrl("~/User/Offer.aspx") %>'><i class="fa-solid fa-gift" style="color: #EF4444; font-size: 11px;"></i>Gift Sets</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-bottom-bar d-flex flex-column flex-sm-row justify-content-between align-items-center">
                    <div>&copy; 2026 TeaMart. All rights reserved.</div>
                    <div class="footer-bottom-links mt-2 mt-sm-0">
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                        <a href="#">Sitemap</a>
                    </div>
                </div>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll("#userNavBar .nav-link, #userNavBar .dropdown-item");

            navLinks.forEach(function (link) {
                var href = link.getAttribute("href");
                if (href && href !== "#") {
                    var targetFile = href.split('/').pop().toLowerCase();
                    if (currentPath.endsWith(targetFile)) {
                        link.classList.add("active");
                        var parentDropdown = link.closest(".dropdown");
                        if (parentDropdown) {
                            var toggle = parentDropdown.querySelector(".dropdown-toggle");
                            if (toggle) toggle.classList.add("active");
                        }
                    } else {
                        link.classList.remove("active");
                    }
                }
            });
        });
    </script>
</body>
</html>